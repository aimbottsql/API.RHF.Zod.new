# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าที่ว่างอยู่
#   cp .env.example .env.local

# สุ่มค่าใหม่ได้ด้วย: npx auth secret
AUTH_SECRET=""

# Google OAuth (Google Cloud Console → Google Auth Platform → Clients)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="123489260300-4dfrr4lrm4qi5bqvakn67fa8mk4jf8pj.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET=""   # ขอจากเจ้าของโปรเจกต์ทางแชทส่วนตัว ห้าม commit

# จำเป็นเมื่อรันด้วย npm run start (production) บนเครื่องตัวเอง
AUTH_TRUST_HOST=true

# ฐานข้อมูล — เลือกบรรทัดเดียว
# แบบ ก: PostgreSQL ที่ติดตั้งด้วย winget (port 5432) → แล้วรัน npm run db:setup
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_explorer"
# แบบ ข: PostgreSQL ในโปรเจกต์ → เปิดด้วย npm run db:start (port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/product_explorer"
